# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# *.meta files can be useful, so if you want to have meta files in your repository, this might be useful:
# *.*.meta

.DS_Store
.AppleDouble
.LSOverride

# ===========================
# Visual Studio cache directory
.vs/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
sysinfo.txt.meta

# Builds
[Bb]uild/
[Bb]uilds/
[Ll]og/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# ===========================
# Visual Studio cache/options directory
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# Rider cache/options directory
.idea/
.idea/**/*

# Gradle cache directory
.gradle

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Custom Unity folders - IMPORTANT!
[Aa]ssets/AssetStoreTools*
[Bb]uild/
[Ll]ibrary/
[Ll]ocal[Cc]ache/
[Oo]bj/
[Tt]emp/
[Uu]serSettings/
[Mm]emoryCaptures/
[Ss]treamingAssets/ignore.meta
[Ss]treamingAssets/ignore

# Autogenerated .class file
*.booproj

# Autogenerated RSA key and its meta file for encryading assemblys
AspNet.ScriptResource.axd

# Csharp DLL
Assembly-CSharp.dll
Assembly-CSharp.dll.mdb